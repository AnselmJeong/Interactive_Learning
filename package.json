{
  "name": "learnie",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "LEARNIE_PROJECT_ROOT=$PWD electrobun dev",
    "dev:watch": "LEARNIE_PROJECT_ROOT=$PWD electrobun dev --watch",
    "start": "LEARNIE_PROJECT_ROOT=$PWD electrobun run",
    "prepare:python-runtime": "bun run scripts/prepare-python-runtime.ts",
    "build:dev": "bun install && bun run prepare:python-runtime && electrobun build",
    "build:stable": "bun run prepare:python-runtime && electrobun build --env=stable",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:python": "cd python && uv run --extra test pytest",
    "smoke:python": "LEARNIE_PROJECT_ROOT=$PWD bun run scripts/smoke-python.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-stone": "^0.7.16",
    "@stylexjs/stylex": "^0.19.2",
    "@vitejs/plugin-react": "^4.5.2",
    "chart.js": "4.4.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "electrobun": "^1.18.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "parse5": "7.3.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@types/bun": "latest",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
